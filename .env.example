DATABASE_URL=
# Optional explicit direct URL for migrations. If blank, Neon direct/pooler host is derived safely.
DATABASE_DIRECT_URL=
# auto = pooled on Vercel for Neon, direct elsewhere; pooled/direct force a mode.
DATABASE_RUNTIME_POOLING=auto
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_CONNECT_RETRIES=2
DATABASE_RETRY_BASE_DELAY_MS=150
DATABASE_RETRY_MAX_DELAY_MS=1200
DATABASE_STATEMENT_TIMEOUT_MS=45000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_MIGRATION_STATEMENT_TIMEOUT_MS=180000
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=30000
ADMIN_API_KEY=
STUDENT_SESSION_SECRET=
# Outside Vercel, enable only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
STARTUP_MIGRATION_LOCK_WAIT_SECONDS=20
STARTUP_MIGRATION_LOCK_POLL_SECONDS=0.25
# Production curriculum/source uploads are locked unless this is explicitly true.
CONTENT_INGESTION_ENABLED=false
PHYSICS_PDF_BUCKET=physics-pdf-sources
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
GEMINI_FILE_SEARCH_STORE=
GEMINI_FILE_SEARCH_DISPLAY_NAME=physics-edu-agent-2026-2027
GEMINI_FILE_SEARCH_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_FILE_SEARCH_AUTO_PROVISION=true
GEMINI_RESEARCH_MAX_PAGES=12
GEMINI_RESEARCH_MAX_INLINE_BYTES=12582912
LESSON_STUDIO_GEMINI_MODEL=gemini-3.8-flash
LESSON_STUDIO_MAX_FILE_BYTES=12582912

# Independent auxiliary Lesson Pack Studio. Does not open official curriculum ingestion.
LESSON_PACK_INGESTION_ENABLED=true
LESSON_PACK_MAX_FILE_BYTES=12582912
LESSON_PACK_MAX_FILES=6
LESSON_PACK_MAX_PAGES=40
LESSON_PACK_RENDER_DPI=144
LESSON_PACK_MAX_SOURCE_VISUALS=8
LESSON_PACK_DEFAULT_QUESTION_COUNT=12
LESSON_STUDIO_PREPROCESS_IMAGES=true
LESSON_STUDIO_PREPROCESS_MAX_EDGE=2200
LESSON_STUDIO_REQUIRE_REFERENCE_REVIEW=false
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
OPENAI_API_KEY=
LESSON_STUDIO_REVIEW_MODEL=gpt-5.6-sol
LESSON_STUDIO_REVIEW_REASONING_EFFORT=high
AI_MODEL_PRICING_JSON=
# Bounded same-provider retry policy for transient AI/OCR transport failures.
# Stateful provider resource creation/upload operations intentionally do not use automatic replay.
AI_PROVIDER_RETRY_ATTEMPTS=3
AI_PROVIDER_RETRY_BASE_DELAY_MS=250
AI_PROVIDER_RETRY_MAX_DELAY_MS=1500
# Optional hard ceilings. Leave blank to keep budget blocking disabled.
AI_DAILY_CALL_BUDGET=
AI_DAILY_COST_BUDGET_USD=
AI_MONTHLY_COST_BUDGET_USD=
# Technical observability thresholds (all optional)
TECH_OBSERVABILITY_DB_WARN_MS=500
TECH_OBSERVABILITY_DB_ERROR_MS=2000
TECH_OBSERVABILITY_AI_MIN_CALLS=5
TECH_OBSERVABILITY_AI_FAILURE_WARN_PCT=10
TECH_OBSERVABILITY_AI_FAILURE_ERROR_PCT=25
TECH_OBSERVABILITY_AI_RETRY_WARN_PCT=20
TECH_OBSERVABILITY_AI_LATENCY_WARN_MS=15000
TECH_OBSERVABILITY_SYNC_STALE_MINUTES=30
TECH_OBSERVABILITY_RATE_LIMIT_NEAR_PCT=80
TECH_OBSERVABILITY_RATE_LIMIT_BLOCKED_ERROR_SUBJECTS=5
RATE_LIMIT_ADMIN_LOGIN_MAX=8
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_STUDENT_LOGIN_MAX=12
RATE_LIMIT_STUDENT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_ADAPTIVE_QUIZ_CREATE_MAX=6
RATE_LIMIT_ADAPTIVE_QUIZ_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_STUDENT_REVIEW_PDF_MAX=20
RATE_LIMIT_STUDENT_REVIEW_PDF_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_AI_RESEARCH_MAX=30
RATE_LIMIT_ADMIN_AI_RESEARCH_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_LESSON_PROCESS_MAX=12
RATE_LIMIT_ADMIN_LESSON_PROCESS_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_SECOND_REVIEW_MAX=10
RATE_LIMIT_ADMIN_SECOND_REVIEW_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_VISUAL_REVIEW_MAX=30
RATE_LIMIT_ADMIN_VISUAL_REVIEW_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_VISUAL_REVIEW_BATCH_MAX=8
RATE_LIMIT_ADMIN_VISUAL_REVIEW_BATCH_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_PHASE2_BOOTSTRAP_MAX=2
RATE_LIMIT_ADMIN_PHASE2_BOOTSTRAP_WINDOW_SECONDS=3600

# Canva Connect API — light scientific autofill master
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://physics-edu-agent.vercel.app/api/integrations/canva/oauth/callback
CANVA_SCOPES=design:content:read design:content:write design:meta:read brandtemplate:content:read brandtemplate:meta:read
# Default source is the tagged Canva design. Override only if the master changes.
CANVA_MASTER_DESIGN_ID=DAHUkN3i5p4
# Optional fallback: when set, Brand Template autofill takes priority over design autofill.
CANVA_BRAND_TEMPLATE_ID=
# Optional JSON override only when Canva field labels differ from the master contract.
CANVA_FIELD_MAP_JSON=
CANVA_AUTOFILL_POLL_SECONDS=1.0
CANVA_AUTOFILL_MAX_POLLS=20
